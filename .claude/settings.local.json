{
  "permissions": {
    "allow": [
      "Bash(mkdir -p assets/css assets/js assets/img)",
      "Bash(mv assets/accessibility-widget.css assets/css/)",
      "Bash(mv assets/accessibility-widget.js assets/js/)",
      "Bash(mv assets/language-selector.js assets/js/)",
      "Bash(mv _dev/hub-theme.css assets/css/)",
      "Bash(mv _dev/hub-theme.js assets/js/)",
      "Bash(mv assets/Hero.svg assets/img/)",
      "Bash(mv assets/GLOCAL_Foundation.avif assets/img/)",
      "Bash(mv assets/Government_Canada.avif assets/img/)",
      "Bash(mv assets/Oasis_of_Change.svg assets/img/)",
      "Bash(mv assets/Website_Carbon.avif assets/img/)",
      "Bash(for f in *.html)",
      "Bash(do)",
      "Bash(sed -i -e 's|href=\"\"hub-theme\\\\.css\"\"|href=\"\"../assets/css/hub-theme.css\"\"|g' -e 's|src=\"\"hub-theme\\\\.js\"\"|src=\"\"../assets/js/hub-theme.js\"\"|g' -e 's|href=\"\"\\\\.\\\\./assets/accessibility-widget\\\\.css\"\"|href=\"\"../assets/css/accessibility-widget.css\"\"|g' -e 's|src=\"\"\\\\.\\\\./assets/accessibility-widget\\\\.js\"\"|src=\"\"../assets/js/accessibility-widget.js\"\"|g' -e 's|src=\"\"\\\\.\\\\./assets/language-selector\\\\.js\"\"|src=\"\"../assets/js/language-selector.js\"\"|g' -e 's|src=\"\"\\\\.\\\\./assets/Government_Canada\\\\.avif\"\"|src=\"\"../assets/img/Government_Canada.avif\"\"|g' -e 's|src=\"\"\\\\.\\\\./assets/GLOCAL_Foundation\\\\.avif\"\"|src=\"\"../assets/img/GLOCAL_Foundation.avif\"\"|g' -e 's|src=\"\"\\\\.\\\\./assets/Website_Carbon\\\\.avif\"\"|src=\"\"../assets/img/Website_Carbon.avif\"\"|g' \"$f\")",
      "Bash(echo \"Updated $f\")",
      "Bash(done)",
      "Bash(echo \"Exit: $?\")"
    ]
  }
}
